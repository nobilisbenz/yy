import { Tokens } from "../tokens.slint";

// `[Note]` `[Code]` `[▶ 06:54]` `[OBS]`
//
// Rendered from trusted `Action` records in the database, never from model
// output (spec §3.3). A target that failed validation at index time arrives
// with `enabled: false` and is shown greyed rather than hidden — a broken link
// you can see beats one that silently vanished.
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <int> index;          // 1-based; drives the Alt+N hint
    in property <bool> enabled: true;
    in property <bool> selected: false;

    callback activated();

    height: 28px;
    width: row.preferred-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Tokens.accent : transparent;
    background: !root.enabled ? transparent
        : root.selected ? Tokens.action-bg-focus
        : touch.has-hover ? Tokens.action-bg-hover
        : Tokens.action-bg;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;

        Text {
            text: root.index <= 9 ? root.index : "";
            font-family: Tokens.font-family;
            font-size: 10px;
            color: Tokens.fg-faint;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            font-family: Tokens.font-family;
            font-size: Tokens.font-meta;
            color: root.enabled ? Tokens.fg : Tokens.fg-faint;
            vertical-alignment: center;
        }
    }
}
