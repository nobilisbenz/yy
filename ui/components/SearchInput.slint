import { Tokens } from "../tokens.slint";

// The query field. Raw `TextInput` rather than a widget-library `LineEdit`:
// this is a bespoke surface, and the widget styling would have to be undone
// more than it would be used.
export component SearchInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Ask anything...";
    in property <bool> busy: false;

    callback accepted(string);
    callback edited(string);
    callback dismissed();

    height: Tokens.input-height;
    background: transparent;

    // Makes the component itself a focus target that lands on the text field,
    // so the window can `forward-focus` here without knowing its internals.
    forward-focus: input;

    HorizontalLayout {
        padding-left: Tokens.pad-x;
        padding-right: Tokens.pad-x;
        spacing: Tokens.gap;

        Rectangle {
            width: 8px;
            // A quiet activity dot. Cheaper to read than a spinner, and it
            // does not compete with text that is streaming in below.
            Rectangle {
                width: 7px;
                height: self.width;
                border-radius: self.width / 2;
                y: (parent.height - self.height) / 2;
                background: root.busy ? Tokens.accent : Tokens.fg-faint;
                opacity: root.busy ? 1.0 : 0.5;
                animate opacity, background { duration: 200ms; }
            }
        }

        Rectangle {
            input := TextInput {
                width: 100%;
                y: (parent.height - self.preferred-height) / 2;
                font-family: Tokens.font-family;
                font-size: Tokens.font-query;
                color: Tokens.fg;
                selection-background-color: Tokens.accent;
                selection-foreground-color: #ffffff;
                single-line: true;
                wrap: no-wrap;

                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.dismissed();
                        return accept;
                    }
                    return reject;
                }
            }

            // Placeholder is drawn, not stored, so it can never be submitted
            // as a query by an errant "select all".
            Text {
                x: 0;
                y: (parent.height - self.preferred-height) / 2;
                visible: input.text == "";
                text: root.placeholder;
                font-family: Tokens.font-family;
                font-size: Tokens.font-query;
                color: Tokens.fg-faint;
            }
        }
    }

    public function focus-input() {
        input.focus();
    }

    public function clear() {
        input.text = "";
    }

    // Caret at the end, per spec §42 — reopening the dock should let you keep
    // typing, not overwrite what is there.
    public function select-all() {
        input.select-all();
    }
}
