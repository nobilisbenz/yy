// Every visual constant in Brain Dock lives here.
//
// Nothing in Rust should name a colour, a radius, or a duration (spec §40).
// The backend decides *what* to show; this file decides what it looks like.

export global Tokens {
    // --- geometry (spec §41) -----------------------------------------------
    out property <length> dock-width: 560px;
    out property <length> input-height: 62px;
    out property <length> answer-min-height: 120px;
    out property <length> answer-max-height: 500px;
    out property <length> radius: 22px;

    out property <length> pad-x: 22px;
    out property <length> pad-y: 16px;
    out property <length> gap: 10px;
    out property <length> gap-tight: 6px;

    // --- type --------------------------------------------------------------
    out property <string> font-family: "Fira Code";
    out property <length> font-query: 17px;
    out property <length> font-answer: 15px;
    out property <length> font-meta: 12px;

    // --- colour ------------------------------------------------------------
    // Tuned against the doom-one palette already in the i3 config, so the dock
    // reads as part of the desktop rather than a visitor.
    out property <color> bg: #1c1f24e8;
    out property <color> bg-raised: #22262e;
    out property <color> border: #ffffff14;
    out property <color> divider: #ffffff0f;

    out property <color> fg: #dfdfdf;
    out property <color> fg-dim: #7f8490;
    out property <color> fg-faint: #5b6268;
    out property <color> accent: #51afef;
    out property <color> danger: #ff6c6b;

    out property <color> action-bg: #ffffff0f;
    out property <color> action-bg-hover: #ffffff1f;
    out property <color> action-bg-focus: #51afef2e;

    // --- motion (spec §41) -------------------------------------------------
    // Show and hide only. Tokens and buttons do not animate; per-token
    // animation reads as lag, not polish.
    out property <duration> show-ms: 100ms;
    out property <duration> hide-ms: 80ms;
    out property <duration> resize-ms: 150ms;
}
